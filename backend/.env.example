# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
# Include the database name "retinacare" in the path:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/retinacare?retryWrites=true&w=majority
MONGO_URI=

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Super Admin Seed ─────────────────────────────────────────────────────────
# Used ONLY by: npm run seed:admin
# Super Admin cannot be created via public signup — only through this seed.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
