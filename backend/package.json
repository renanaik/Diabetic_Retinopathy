{
  "name": "retinacare-backend",
  "version": "1.0.0",
  "description": "RetinaCare AI — Node.js/Express backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "seed:admin": "ts-node src/scripts/seedSuperAdmin.ts",
    "test:5c": "ts-node src/scripts/testPhase5C.ts",
    "test:5d": "ts-node src/scripts/testPhase5D.ts",
    "test:5e": "ts-node src/scripts/testPhase5E.ts",
    "test:5f": "ts-node src/scripts/testPhase5F.ts",
    "test:5g": "ts-node src/scripts/testPhase5G.ts",
    "test:5h": "ts-node src/scripts/testPhase5H.ts",
    "ml:start": "ml_service/venv/bin/python ml_service/app.py"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "axios": "^1.19.0",
    "form-data": "^4.0.6",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
